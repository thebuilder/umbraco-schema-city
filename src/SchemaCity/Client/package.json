{
  "name": "schema-city",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev dev -c vite.config.ts",
    "watch": "tsc && vite build --watch",
    "build": "tsc && vite build",
    "build:demo": "tsc && vite build --config vite.demo.config.ts",
    "preview:demo": "vite preview --config vite.demo.config.ts",
    "test": "vitest run",
    "lint": "ultracite check",
    "format": "ultracite fix",
    "check": "tsc --noEmit",
    "fallow": "fallow audit --gate new-only"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@umbraco-cms/backoffice": "^17.7.1",
    "fallow": "3.33.1",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "ultracite": "^8.0.0",
    "vite": "^7.3.7",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@dagrejs/dagre": "3.1.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.56.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "three": "0.186.1"
  }
}
