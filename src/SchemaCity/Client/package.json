{
  "name": "@schema-city/client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "watch": "vite build --watch",
    "dev": "vite dev clean/dev -c vite.config.ts",
    "dev:city": "vite dev city/dev -c vite.config.ts",
    "build:demo": "tsc && vite build -c vite.demo.config.ts && vite build -c vite.demo.config.ts --mode city",
    "preview:demo": "vite preview -c vite.demo.config.ts",
    "test": "vitest run",
    "lint": "ultracite check",
    "format": "ultracite fix",
    "check": "tsc --noEmit",
    "fallow": "fallow audit --gate new-only"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "0.186.0",
    "@umbraco-cms/backoffice": "catalog:",
    "fallow": "3.33.1",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "ultracite": "8.0.0",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
