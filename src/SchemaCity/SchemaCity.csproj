<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <!-- NuGet audits the range floor, 17.0.0, but the host site picks the Umbraco version that
         actually runs, so the floor's transitive advisories are not what this package ships. -->
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SchemaCity</PackageId>
    <Product>SchemaCity</Product>
    <Title>Schema City</Title>
    <Authors>Daniel Schmidt</Authors>
    <Description>Renders the Umbraco content model as an isometric city in the backoffice.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>umbraco umbraco-marketplace backoffice document-types visualisation three.js</PackageTags>
    <PackageProjectUrl>https://github.com/thebuilder/umbraco-schema-city</PackageProjectUrl>
    <RepositoryUrl>https://github.com/thebuilder/umbraco-schema-city</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- One package for Umbraco 17 and 18. NuGet resolves the lowest version in the range here and
       the host site's own reference decides what actually loads. -->
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Api.Common" Version="[17.0.0, 19.0.0)" />
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="[17.0.0, 19.0.0)" />
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="[17.0.0, 19.0.0)" />
    <PackageReference Include="Umbraco.Cms.Web.Website" Version="[17.0.0, 19.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The client sources are build input, not package content. -->
    <Content Remove="Client\**" />
    <None Include="Client\public\umbraco-package.json" Pack="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <!-- The package ships the built client, so a clean checkout has to build it before the
       static web assets are collected. wwwroot/ is generated and gitignored, and the SDK
       globs Content at evaluation time, before any target runs, so the files Vite has just
       written are added back to Content here. Set SkipClientBuild=true where npm has
       already run, as CI does. -->
  <Target Name="BuildClient"
          BeforeTargets="ResolveProjectStaticWebAssets"
          Condition="'$(SkipClientBuild)' != 'true' And !Exists('$(MSBuildProjectDirectory)/wwwroot/App_Plugins/SchemaCity/workspace.js')">
    <!-- ponytail: missing output only, not a timestamp comparison against the client
         sources. Editing the client and building only the .NET side leaves stale JS, which
         is what `npm run watch` is for. Add Inputs/Outputs if that ever bites. -->
    <Exec Command="npm ci" WorkingDirectory="Client" Condition="!Exists('$(MSBuildProjectDirectory)/Client/node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="Client" />
    <ItemGroup>
      <Content Include="wwwroot\**" Exclude="@(Content)" />
    </ItemGroup>
  </Target>

</Project>
