<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <!-- NuGet audits the range floor, 17.0.0, but the host site picks the Umbraco version that
         actually runs, so the floor's transitive advisories are not what this package ships. -->
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SchemaCity</PackageId>
    <Product>SchemaCity</Product>
    <Title>Schema City</Title>
    <Authors>Daniel Schmidt</Authors>
    <Description>Renders the Umbraco content model as an isometric city in the backoffice.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <!-- One package for Umbraco 17 and 18. NuGet resolves the lowest version in the range here and
       the host site's own reference decides what actually loads. -->
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Api.Common" Version="[17.0.0, 19.0.0)" />
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="[17.0.0, 19.0.0)" />
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="[17.0.0, 19.0.0)" />
    <PackageReference Include="Umbraco.Cms.Web.Website" Version="[17.0.0, 19.0.0)" />

    <!--
      Swashbuckle comes in transitively from the Umbraco packages, but the composer uses
      SwaggerGenOptions and OpenApiInfo directly. Without a direct reference NuGet can resolve a
      different Swashbuckle here than in the host site, and the two Microsoft.OpenApi versions then
      clash at runtime so the schema-city Swagger document never appears.
    -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The client sources are build input, not package content. -->
    <Content Remove="Client\**" />
    <None Include="Client\public\umbraco-package.json" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

</Project>
