{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/SchemaCity.Site"
      ],
      "port": 61801
    },
    {
      "name": "harness",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "src/SchemaCity/Client",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "harness-city",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "src/SchemaCity/Client",
        "dev:city",
        "--port",
        "5174"
      ],
      "port": 5174
    },
    {
      "name": "demo-dist",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5310",
        "-d",
        "src/SchemaCity/Client/dist"
      ],
      "port": 5310
    },
    {
      "name": "docs-dist",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5320",
        "-d",
        "apps/docs/dist"
      ],
      "port": 5320
    }
  ]
}
